<%- include('../../layouts/header') %>

<%- include('../../layouts/breadcrumbs', {
  breadcrumbs: [
    { label: 'Profile & Security' }
  ]
}) %>

<div class="profile-grid">
  <!-- Left Column: User Profile & Company Metadata -->
  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    <!-- User Profile Card -->
    <div class="profile-card">
      <div class="profile-header-block">
        <div class="profile-avatar-large">
          <%= formatters.initials(currentUser.name) %>
        </div>
        <div>
          <h2 style="font-size: 1.25rem; font-weight: 700;"><%= currentUser.name %></h2>
          <span style="font-size: 0.85rem; color: var(--text-muted);"><%= currentUser.email %></span>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 0.5rem;">
        <div style="background-color: var(--bg-primary); padding: 0.9rem; border-radius: var(--radius-md); border: 1px solid var(--border-color); text-align: center;">
          <div style="font-size: 1.4rem; font-weight: 800; color: var(--color-primary);"><%= partiesCount %></div>
          <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Total Parties</div>
        </div>

        <div style="background-color: var(--bg-primary); padding: 0.9rem; border-radius: var(--radius-md); border: 1px solid var(--border-color); text-align: center;">
          <div style="font-size: 1.4rem; font-weight: 800; color: var(--color-credit);"><%= txCount %></div>
          <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Transactions</div>
        </div>
      </div>

      <div style="margin-top: 0.5rem; padding-top: 0.75rem; border-top: 1px solid var(--border-color);">
        <a href="/logout" class="btn btn-danger btn-block btn-sm" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          Logout from Session
        </a>
      </div>
    </div>

    <!-- Company Branding Card (From .env) -->
    <div class="profile-card">
      <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
        Business Information (.env)
      </h3>

      <div>
        <div class="company-meta-item">
          <span class="company-meta-label">Business Name</span>
          <span class="company-meta-value"><%= company.name %></span>
        </div>

        <div class="company-meta-item">
          <span class="company-meta-label">Contact Phone</span>
          <span class="company-meta-value"><%= company.phone || '-' %></span>
        </div>

        <div class="company-meta-item">
          <span class="company-meta-label">Office Address</span>
          <span class="company-meta-value"><%= company.address || '-' %></span>
        </div>
      </div>

      <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem; line-height: 1.4;">
        Note: Company branding details are configured in <code>.env</code> and automatically appear on all generated PDF and Excel reports.
      </p>
    </div>
  </div>

  <!-- Right Column: Reset Password Form -->
  <div class="profile-card">
    <div style="border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
      <h2 style="font-size: 1.25rem; font-weight: 700;">Security & Password Reset</h2>
      <p style="font-size: 0.825rem; color: var(--text-muted); margin-top: 0.25rem;">
        Changing your password will immediately end your current session and require you to sign in again.
      </p>
    </div>

    <form action="/profile/reset-password" method="POST" style="display: flex; flex-direction: column; gap: 1.15rem;">
      <div class="form-group">
        <label for="previous_password" class="form-label required">Current Password</label>
        <input 
          type="password" 
          id="previous_password" 
          name="previous_password" 
          class="form-control" 
          placeholder="Enter current password" 
          required 
          autofocus
        >
      </div>

      <div class="form-group">
        <label for="new_password" class="form-label required">New Password</label>
        <input 
          type="password" 
          id="new_password" 
          name="new_password" 
          class="form-control" 
          placeholder="At least 8 characters" 
          required
        >
        <div class="password-requirements" style="margin-top: 0.4rem;">
          Must contain minimum 8 characters with at least 1 uppercase letter, 1 lowercase letter, and 1 number.
        </div>
      </div>

      <div class="form-group">
        <label for="confirm_new_password" class="form-label required">Confirm New Password</label>
        <input 
          type="password" 
          id="confirm_new_password" 
          name="confirm_new_password" 
          class="form-control" 
          placeholder="Re-enter new password" 
          required
        >
      </div>

      <div style="margin-top: 0.5rem;">
        <button type="submit" class="btn btn-primary btn-block" style="padding: 0.85rem;">
          Update Password & Logout
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../../layouts/footer') %>
