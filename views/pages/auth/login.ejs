<%- include('../../layouts/header') %>

  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-header">
        <img src="/images/logo.png" alt="Logo" class="auth-logo" onerror="this.src='/icons/icon-128x128.png'">
        <h1 class="auth-title">Welcome Back</h1>
        <p class="auth-subtitle">Login to <%= company.name %> Khatabook</p>
      </div>

      <form action="/login" method="POST" class="auth-form">
        <div class="form-group">
          <label for="email" class="form-label required">Email Address</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="your@email.com"
            value="<%= typeof oldInput !== 'undefined' && oldInput.email ? oldInput.email : '' %>" required autofocus>
        </div>

        <div class="form-group">
          <label for="password" class="form-label required">Password</label>
          <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
        </div>

        <div class="remember-wrapper">
          <label class="remember-label" for="remember">
            <input type="checkbox" id="remember" name="remember" value="true" class="remember-checkbox" checked>
            <span>Remember me for 15 days</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-block" style="margin-top: 0.25rem; padding: 0.85rem;">
          Sign In to Ledger
        </button>
      </form>

      <div class="auth-footer" style="display: flex; flex-direction: column; gap: 0.75rem;">
        <div
          style="background: rgba(37, 99, 235, 0.08); border: 1px dashed rgba(37, 99, 235, 0.35); border-radius: 8px; padding: 0.75rem 1rem;">
          <span style="font-size: 0.85rem; color: var(--text-main); font-weight: 500;">Are you a Customer /
            Party?</span>
          <div style="margin-top: 0.25rem;">
            <a href="/portal/login" class="auth-link" style="font-weight: 700; color: var(--primary-color);">
              View Your Passbook &rarr;
            </a>
          </div>
        </div>
        <% if (typeof allowRegistration !=='undefined' && allowRegistration) { %>
          <div>
            Don't have an account? <a href="/register" class="auth-link">Create Account</a>
          </div>
          <% } %>
      </div>
    </div>
  </div>

  <%- include('../../layouts/footer') %>