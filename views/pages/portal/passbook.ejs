<%- include('../../layouts/header') %>

  <% const isPreviewMode=(typeof isPreview !=='undefined' && isPreview); %>
    <% const passbookBaseUrl=isPreviewMode ? ('/portal/preview/' + party.id) : '/portal/passbook' ; %>

      <% if (isPreviewMode) { %>
        <div
          style="background: #FEF3C7; border: 1px solid #F59E0B; color: #92400E; padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1.25rem; display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span><strong>Shopkeeper Preview Mode:</strong> You are viewing this digital passbook exactly as <strong>
                <%= party.name %>
              </strong> sees it. (Read-Only)</span>
          </div>
          <a href="/parties/<%= party.id %>/ledger" class="btn btn-secondary btn-sm" style="background: white;">Back to
            Admin Ledger &rarr;</a>
        </div>
        <% } %>

          <!-- Passbook Header Card (Identical to Admin Ledger Screen) -->
          <% const bal=Number(party.current_balance) || 0; %>
            <section class="ledger-header-card">
              <div class="ledger-top-row">
                <div class="party-detail-info">
                  <div class="party-avatar-large">
                    <%= formatters.initials(party.name) %>
                  </div>
                  <div class="party-title-block">
                    <h1>
                      <%= party.name %>
                    </h1>
                    <!-- Realtime Status Pill Beside Name -->
                    <div class="header-balance-pill">
                      <% if (bal> 0) { %>
                        <span class="badge badge-debit">
                          <%= formatters.currency(bal) %> You'll Give
                        </span>
                        <% } else if (bal < 0) { %>
                          <span class="badge badge-credit">
                            <%= formatters.currency(Math.abs(bal)) %> You'll Get
                          </span>
                          <% } else { %>
                            <span class="badge badge-settled">Settled (₹0)</span>
                            <% } %>
                    </div>
                  </div>
                </div>

                <!-- Universal Accordion Toggle Button (Active on All Screens: Mobile, Tablet, Laptop, Desktop) -->
                <button type="button" id="togglePartyAccordionBtn" class="party-accordion-toggle-btn"
                  aria-expanded="false" title="Click to view/hide store owner details & reports">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                  </svg>
                  <span class="accordion-btn-text">Owner Details</span>
                  <svg class="accordion-chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
              </div>

              <!-- Collapsible Details Body (Exact same accordion structure as Admin Ledger!) -->
              <div id="partyDetailsAccordion" class="party-details-accordion">
                <div class="accordion-content-inner">
                  <div class="accordion-grid-layout">
                    <!-- Column 1: Store Contact -->
                    <div class="accordion-col">
                      <span class="accordion-col-title">Contact & Communication</span>
                      <% if (company.phone) { %>
                        <div class="party-contact-row">
                          <div class="party-phone-box">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path
                                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                              </path>
                            </svg>
                            <span class="phone-digits">
                              <%= company.phone %>
                            </span>
                          </div>

                          <div class="party-comm-buttons">
                            <a href="tel:<%= company.phone %>" class="btn btn-secondary btn-sm btn-touch-call"
                              title="Call <%= company.name %>">
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path
                                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                                </path>
                              </svg>
                              <span>Call</span>
                            </a>
                          </div>
                        </div>
                        <% } %>
                          <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.35rem;">
                            Store: <strong>
                              <%= company.name %>
                            </strong>
                          </div>
                    </div>

                    <!-- Column 2: Account Details -->
                    <div class="accordion-col">
                      <span class="accordion-col-title">Account Details</span>
                      <div style="font-size: 0.85rem; color: var(--text-main); font-weight: 600;">
                        📱 Mobile: <%= party.mobile_no || 'N/A' %>
                      </div>
                      <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;">
                        🔒 Official Digital Ledger (Read-Only)
                      </div>
                    </div>

                    <!-- Column 3: Reports & Downloads -->
                    <div class="accordion-col">
                      <span class="accordion-col-title">Download Statements</span>
                      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <a href="<%= isPreviewMode ? ('/parties/' + party.id + '/report/pdf') : '/portal/report/pdf' %>"
                          class="btn btn-secondary btn-sm" title="Download Verified PDF">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                          </svg>
                          <span>Download PDF</span>
                        </a>
                        <a href="<%= isPreviewMode ? ('/parties/' + party.id + '/report/xlsx') : '/portal/report/xlsx' %>"
                          class="btn btn-secondary btn-sm" title="Download Excel">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="8" y1="13" x2="16" y2="17"></line>
                            <line x1="16" y1="13" x2="8" y2="17"></line>
                          </svg>
                          <span>Download Excel</span>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </section>

            <!-- Filter & Search Controls (Exact same as Admin Ledger Show Page) -->
            <section class="ledger-filter-card">
              <form id="passbookFilterForm" action="<%= passbookBaseUrl %>" method="GET">
                <div class="filter-primary-row">
                  <div class="search-input-wrapper">
                    <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="11" cy="11" r="8"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" name="search" class="form-control search-input"
                      placeholder="Search by note, item or bill #..." value="<%= search %>">
                  </div>

                  <button type="button" id="toggleFilterDrawerBtn"
                    class="btn btn-secondary filter-toggle-btn <%= (startDate || endDate || (typeof limit !== 'undefined' && limit !== 20)) ? 'has-active-filter' : '' %>"
                    title="Toggle Date & Page Limit Filters">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                    </svg>
                    <span>Filters</span>
                    <% if (startDate || endDate || (typeof limit !=='undefined' && limit !==20)) { %>
                      <span class="filter-indicator-dot"></span>
                      <% } %>
                  </button>

                  <button type="submit" class="btn btn-primary btn-search-go desktop-only">
                    Search
                  </button>
                </div>

                <!-- Quick Type Filter Pills (Exact styling as Admin Ledger!) -->
                <div class="ledger-type-pills filter-pills">
                  <a href="<%= passbookBaseUrl %>?<%= search ? 'search=' + encodeURIComponent(search) + '&' : '' %><%= startDate ? 'startDate=' + startDate + '&' : '' %><%= endDate ? 'endDate=' + endDate + '&' : '' %>limit=<%= limit %>"
                    class="filter-pill <%= !type ? 'active' : '' %>">
                    All Transactions
                  </a>
                  <a href="<%= passbookBaseUrl %>?type=DEBIT<%= search ? '&search=' + encodeURIComponent(search) : '' %><%= startDate ? '&startDate=' + startDate : '' %><%= endDate ? '&endDate=' + endDate : '' %>&limit=<%= limit %>"
                    class="filter-pill filter-pill-debit <%= type === 'DEBIT' ? 'active' : '' %>">
                    You Gave (Debit)
                  </a>
                  <a href="<%= passbookBaseUrl %>?type=CREDIT<%= search ? '&search=' + encodeURIComponent(search) : '' %><%= startDate ? '&startDate=' + startDate : '' %><%= endDate ? '&endDate=' + endDate : '' %>&limit=<%= limit %>"
                    class="filter-pill filter-pill-credit <%= type === 'CREDIT' ? 'active' : '' %>">
                    You Got (Credit)
                  </a>
                </div>

                <input type="hidden" name="type" value="<%= type %>">

                <!-- Collapsible Advanced Filter Drawer (Dates & Page Limit) -->
                <div id="ledgerFilterDrawer"
                  class="ledger-filter-drawer <%= (startDate || endDate || (typeof limit !== 'undefined' && limit !== 20)) ? 'open' : '' %>">
                  <div class="drawer-fields-grid">
                    <div class="drawer-field">
                      <label class="drawer-label">From Date:</label>
                      <input type="date" name="startDate" class="form-control form-control-sm" value="<%= startDate %>">
                    </div>

                    <div class="drawer-field">
                      <label class="drawer-label">To Date:</label>
                      <input type="date" name="endDate" class="form-control form-control-sm" value="<%= endDate %>">
                    </div>

                    <div class="drawer-field">
                      <label class="drawer-label">Per Page:</label>
                      <select id="passbookLimitSelect" name="limit" class="form-control form-control-sm limit-dropdown">
                        <option value="10" <%=limit===10 ? 'selected' : '' %>>10 per page</option>
                        <option value="20" <%=limit===20 ? 'selected' : '' %>>20 per page</option>
                        <option value="30" <%=limit===30 ? 'selected' : '' %>>30 per page</option>
                        <option value="50" <%=limit===50 ? 'selected' : '' %>>50 per page</option>
                        <option value="100" <%=limit===100 ? 'selected' : '' %>>100 per page</option>
                      </select>
                    </div>

                    <div class="drawer-actions">
                      <button type="submit" class="btn btn-primary btn-sm">Apply Filters</button>
                      <% if (search || type || startDate || endDate || (typeof limit !=='undefined' && limit !==20)) {
                        %>
                        <a href="<%= passbookBaseUrl %>" class="btn btn-secondary btn-sm"
                          style="color: var(--text-muted);">Clear</a>
                        <% } %>
                    </div>
                  </div>
                </div>
              </form>
            </section>

            <!-- Transactions Container (Identical to Admin Ledger Screen) -->
            <section class="transaction-table-container">
              <!-- Desktop Table (Screen >= 768px) -->
              <div class="table-responsive desktop-only-table">
                <table class="table">
                  <thead>
                    <tr>
                      <th style="width: 140px;">Date</th>
                      <th>Details & Remarks</th>
                      <th style="text-align: right; width: 170px;">Items / Taken (Debit +)</th>
                      <th style="text-align: right; width: 170px;">Payment to Shop (Credit -)</th>
                      <th style="text-align: right; width: 150px;">Running Balance</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (transactions && transactions.length> 0) { %>
                      <% transactions.forEach(function(tx) { %>
                        <% const isDebit=tx.type==='DEBIT' ; %>
                          <% const runningBal=Number(tx.balance_after) || 0; %>
                            <tr>
                              <td style="white-space: nowrap; font-weight: 500;">
                                <%= formatters.date(tx.transaction_date) %>
                              </td>
                              <td>
                                <div style="font-weight: 600;">
                                  <%= tx.notes || (isDebit ? 'Item / Goods purchase' : 'Payment received by shop' ) %>
                                </div>
                                <% if (tx.bill_reference) { %>
                                  <span class="tx-ref">Ref: <%= tx.bill_reference %></span>
                                  <% } %>
                              </td>
                              <td style="text-align: right;">
                                <% if (isDebit) { %>
                                  <span class="amount-debit">
                                    <%= formatters.currency(tx.amount) %>
                                  </span>
                                  <% } else { %>
                                    <span style="color: var(--text-muted);">-</span>
                                    <% } %>
                              </td>
                              <td style="text-align: right;">
                                <% if (!isDebit) { %>
                                  <span class="amount-credit">
                                    <%= formatters.currency(tx.amount) %>
                                  </span>
                                  <% } else { %>
                                    <span style="color: var(--text-muted);">-</span>
                                    <% } %>
                              </td>
                              <td style="text-align: right; font-weight: 700;">
                                <% if (runningBal> 0) { %>
                                  <span style="color: var(--color-debit);">
                                    <%= formatters.currency(runningBal) %> Due
                                  </span>
                                  <% } else if (runningBal < 0) { %>
                                    <span style="color: var(--color-credit);">
                                      <%= formatters.currency(Math.abs(runningBal)) %> Adv
                                    </span>
                                    <% } else { %>
                                      <span style="color: var(--text-muted);">₹0.00</span>
                                      <% } %>
                              </td>
                            </tr>
                            <% }); %>
                              <% } else { %>
                                <tr>
                                  <td colspan="5"
                                    style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
                                    No transactions recorded yet in this period.
                                  </td>
                                </tr>
                                <% } %>
                  </tbody>
                </table>
              </div>

              <!-- Mobile Transaction Cards Stream (Screen < 768px - Identical to Admin Ledger Cards) -->
              <div class="mobile-tx-stream">
                <% if (transactions && transactions.length> 0) { %>
                  <% transactions.forEach(function(tx) { %>
                    <% const isDebit=tx.type==='DEBIT' ; %>
                      <% const runningBal=Number(tx.balance_after) || 0; %>
                        <div class="mobile-tx-card <%= isDebit ? 'card-debit' : 'card-credit' %>">
                          <div class="tx-card-header">
                            <span class="tx-card-date">
                              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                              </svg>
                              <%= formatters.date(tx.transaction_date) %>
                            </span>

                            <% if (isDebit) { %>
                              <span class="badge badge-debit">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                  <line x1="12" y1="5" x2="12" y2="19"></line>
                                  <polyline points="19 12 12 19 5 12"></polyline>
                                </svg>
                                YOU GAVE
                              </span>
                              <% } else { %>
                                <span class="badge badge-credit">
                                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="19" x2="12" y2="5"></line>
                                    <polyline points="5 12 12 5 19 12"></polyline>
                                  </svg>
                                  YOU GOT
                                </span>
                                <% } %>
                          </div>

                          <div class="tx-card-body">
                            <div class="tx-card-details">
                              <div class="tx-card-notes">
                                <%= tx.notes || (isDebit ? 'Item / Goods purchase' : 'Payment received by shop' ) %>
                              </div>
                              <% if (tx.bill_reference) { %>
                                <span class="tx-card-ref">Ref: <%= tx.bill_reference %></span>
                                <% } %>
                            </div>

                            <div class="tx-card-amount <%= isDebit ? 'amount-debit' : 'amount-credit' %>">
                              <%= formatters.currency(tx.amount) %>
                            </div>
                          </div>

                          <div class="tx-card-footer">
                            <div class="tx-card-balance">
                              <span class="balance-tag">Balance:</span>
                              <span class="balance-val"
                                style="<%= runningBal > 0 ? 'color: var(--color-debit); font-weight: 700;' : (runningBal < 0 ? 'color: var(--color-credit); font-weight: 700;' : '') %>">
                                <%= formatters.currency(Math.abs(runningBal)) %>
                                  <%= runningBal> 0 ? 'Due' : (runningBal < 0 ? 'Advance' : 'Settled' ) %>
                              </span>
                            </div>
                          </div>
                        </div>
                        <% }); %>
                          <% } else { %>
                            <div class="empty-state"
                              style="padding: 3rem 1.5rem; text-align: center; background: white; border: 1px solid var(--border-color); border-radius: var(--radius-md);">
                              <h4 style="font-weight: 700; color: var(--text-main); margin-bottom: 0.25rem;">No
                                Transactions Found</h4>
                              <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">No credit or debit
                                entries recorded in this period.</p>
                            </div>
                            <% } %>
              </div>

              <!-- Pagination -->
              <% if (totalPages> 1) { %>
                <div class="pagination" style="padding: 1.25rem;">
                  <div>Page <%= currentPage %> of <%= totalPages %> (Total <%= totalCount %> records)</div>
                  <div class="pagination-controls">
                    <% if (currentPage> 1) { %>
                      <a href="<%= passbookBaseUrl %>?page=<%= currentPage - 1 %><%= type ? '&type=' + type : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= startDate ? '&startDate=' + startDate : '' %><%= endDate ? '&endDate=' + endDate : '' %>&limit=<%= limit %>"
                        class="page-btn">
                        &larr;
                      </a>
                      <% } %>
                        <% if (currentPage < totalPages) { %>
                          <a href="<%= passbookBaseUrl %>?page=<%= currentPage + 1 %><%= type ? '&type=' + type : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= startDate ? '&startDate=' + startDate : '' %><%= endDate ? '&endDate=' + endDate : '' %>&limit=<%= limit %>"
                            class="page-btn">
                            &rarr;
                          </a>
                          <% } %>
                  </div>
                </div>
                <% } %>
            </section>

            <%- include('../../layouts/footer') %>