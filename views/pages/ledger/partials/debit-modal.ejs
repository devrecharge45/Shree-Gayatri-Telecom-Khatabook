<!-- You Gave (Debit / Credit Given) Modal -->
<div id="debitModal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header" style="border-top: 4px solid var(--color-debit);">
      <h2 class="modal-title" style="color: var(--color-debit);">You Gave ₹ (Debit / Goods Given)</h2>
      <button type="button" class="alert-close" data-close-modal>&times;</button>
    </div>

    <form action="/parties/<%= party.id %>/transactions" method="POST">
      <input type="hidden" name="type" value="DEBIT">
      
      <div class="modal-body">
        <div class="form-group">
          <label for="debit_amount" class="form-label required">Amount (₹)</label>
          <input 
            type="number" 
            step="0.01" 
            min="0.01" 
            id="debit_amount" 
            name="amount" 
            class="form-control" 
            placeholder="0.00" 
            style="font-size: 1.5rem; font-weight: 800; color: var(--color-debit);" 
            required 
            autofocus
          >
          <span class="form-text-muted">Enter money or goods value given to <%= party.name %></span>
        </div>

        <div class="form-group">
          <label for="debit_date" class="form-label required">Date</label>
          <input 
            type="date" 
            id="debit_date" 
            name="transaction_date" 
            class="form-control" 
            value="<%= new Date().toISOString().slice(0, 10) %>" 
            required
          >
        </div>

        <div class="form-group">
          <label for="debit_notes" class="form-label">Notes / Items Description</label>
          <input 
            type="text" 
            id="debit_notes" 
            name="notes" 
            class="form-control" 
            placeholder="e.g. 5x Mobile Chargers, Screen Guards"
          >
        </div>

        <div class="form-group">
          <label for="debit_ref" class="form-label">Invoice / Bill Reference No.</label>
          <input 
            type="text" 
            id="debit_ref" 
            name="bill_reference" 
            class="form-control" 
            placeholder="e.g. INV-2026-089"
          >
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
        <button type="submit" class="btn btn-debit">Save Entry</button>
      </div>
    </form>
  </div>
</div>
