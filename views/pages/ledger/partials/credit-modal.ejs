<!-- You Got (Credit / Payment Received) Modal -->
<div id="creditModal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header" style="border-top: 4px solid var(--color-credit);">
      <h2 class="modal-title" style="color: var(--color-credit);">You Got ₹ (Credit / Payment)</h2>
      <button type="button" class="alert-close" data-close-modal>&times;</button>
    </div>

    <form action="/parties/<%= party.id %>/transactions" method="POST">
      <input type="hidden" name="type" value="CREDIT">
      
      <div class="modal-body">
        <div class="form-group">
          <label for="credit_amount" class="form-label required">Amount (₹)</label>
          <input 
            type="number" 
            step="0.01" 
            min="0.01" 
            id="credit_amount" 
            name="amount" 
            class="form-control" 
            placeholder="0.00" 
            style="font-size: 1.5rem; font-weight: 800; color: var(--color-credit);" 
            required 
            autofocus
          >
          <span class="form-text-muted">Enter amount received from <%= party.name %></span>
        </div>

        <div class="form-group">
          <label for="credit_date" class="form-label required">Date</label>
          <input 
            type="date" 
            id="credit_date" 
            name="transaction_date" 
            class="form-control" 
            value="<%= new Date().toISOString().slice(0, 10) %>" 
            required
          >
        </div>

        <div class="form-group">
          <label for="credit_notes" class="form-label">Notes / Description</label>
          <input 
            type="text" 
            id="credit_notes" 
            name="notes" 
            class="form-control" 
            placeholder="e.g. Received via UPI / Cash payment"
          >
        </div>

        <div class="form-group">
          <label for="credit_ref" class="form-label">Receipt / Bill Reference No.</label>
          <input 
            type="text" 
            id="credit_ref" 
            name="bill_reference" 
            class="form-control" 
            placeholder="e.g. UPI-12345678 or Rec #402"
          >
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
        <button type="submit" class="btn btn-credit">Save Payment</button>
      </div>
    </form>
  </div>
</div>
