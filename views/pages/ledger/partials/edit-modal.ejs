<!-- Edit Transaction Modal -->
<div id="editTxModal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header" style="border-top: 4px solid var(--color-primary);">
      <h2 class="modal-title" style="color: var(--color-primary);">Edit Transaction Entry</h2>
      <button type="button" class="alert-close" data-close-modal>&times;</button>
    </div>

    <form id="editTxForm" action="" method="POST">
      <div class="modal-body">
        <div class="form-group">
          <label for="edit_tx_type" class="form-label required">Transaction Type</label>
          <select id="edit_tx_type" name="type" class="form-control" required>
            <option value="DEBIT">You Gave ₹ (Debit / Goods or Cash Given)</option>
            <option value="CREDIT">You Got ₹ (Credit / Payment Received)</option>
          </select>
          <span class="form-text-muted">Choose whether you gave credit or received a payment</span>
        </div>

        <div class="form-group">
          <label for="edit_tx_amount" class="form-label required">Amount (₹)</label>
          <input 
            type="number" 
            step="0.01" 
            min="0.01" 
            id="edit_tx_amount" 
            name="amount" 
            class="form-control" 
            placeholder="0.00" 
            style="font-size: 1.4rem; font-weight: 800; color: var(--color-primary);" 
            required
          >
        </div>

        <div class="form-group">
          <label for="edit_tx_date" class="form-label required">Transaction Date</label>
          <input 
            type="date" 
            id="edit_tx_date" 
            name="transaction_date" 
            class="form-control" 
            required
          >
        </div>

        <div class="form-group">
          <label for="edit_tx_notes" class="form-label">Notes / Description</label>
          <input 
            type="text" 
            id="edit_tx_notes" 
            name="notes" 
            class="form-control" 
            placeholder="e.g. Items purchased or invoice description"
          >
        </div>

        <div class="form-group">
          <label for="edit_tx_ref" class="form-label">Bill / Receipt Reference No.</label>
          <input 
            type="text" 
            id="edit_tx_ref" 
            name="bill_reference" 
            class="form-control" 
            placeholder="e.g. INV-2026-089 or UPI-12345678"
          >
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
        <button type="submit" class="btn btn-primary">Update Transaction</button>
      </div>
    </form>
  </div>
</div>
