<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= typeof title !== 'undefined' ? title : (app ? app.appName : 'Khatabook') %></title>
  
  <!-- PWA Meta Tags -->
  <meta name="theme-color" content="#1E293B">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="<%= app ? app.appShortName : 'Khatabook' %>">
  
  <!-- Favicons & App Icons (From Local Project Assets) -->
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">

  <!-- Zero CDN Local CSS Stylesheets -->
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <% if (typeof currentPath !== 'undefined') { %>
    <% if (currentPath.includes('/login') || currentPath.includes('/register')) { %>
      <link rel="stylesheet" href="/css/pages/auth.css">
    <% } else if (currentPath.includes('/ledger')) { %>
      <link rel="stylesheet" href="/css/pages/ledger.css">
    <% } else if (currentPath.includes('/profile')) { %>
      <link rel="stylesheet" href="/css/pages/profile.css">
    <% } else { %>
      <link rel="stylesheet" href="/css/pages/parties.css">
    <% } %>
  <% } %>
</head>
<body>
  <!-- Header -->
  <header class="app-header">
    <nav class="navbar">
      <a href="/parties" class="brand-wrapper">
        <img src="/images/logo.png" alt="Logo" class="brand-logo" onerror="this.src='/icons/icon-96x96.png'">
        <div class="brand-info">
          <span class="brand-title"><%= company.name %></span>
          <span class="brand-subtitle"><%= app.appShortName %></span>
        </div>
      </a>

      <div class="nav-links desktop-only">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <a href="/parties" class="nav-link <%= currentPath === '/parties' ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            Parties
          </a>
          <a href="/profile" class="nav-link <%= currentPath === '/profile' ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            Profile
          </a>
          
          <!-- PWA Install Button (Hidden until available) -->
          <button id="pwa-install-btn" class="btn btn-secondary btn-sm" style="display: none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Install App
          </button>

          <div class="user-pill">
            <span class="user-avatar-small"><%= formatters.initials(currentUser.name) %></span>
            <span><%= currentUser.name.split(' ')[0] %></span>
          </div>

          <a href="/logout" class="btn btn-danger btn-sm" title="Logout">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          </a>
        <% } else { %>
          <a href="/login" class="btn btn-secondary btn-sm">Login</a>
          <a href="/register" class="btn btn-primary btn-sm">Register</a>
        <% } %>
      </div>
    </nav>
  </header>

  <main class="app-container">
    <%- include('./flash') %>
