  </main>

  <!-- Mobile Bottom Navigation Bar (Hidden on Ledger Page where Action Dock is active) -->
  <% if (typeof currentUser !== 'undefined' && currentUser && typeof currentPath !== 'undefined' && !currentPath.includes('/ledger')) { %>
    <nav class="bottom-nav">
      <div class="bottom-nav-inner">
        <a href="/parties" class="bottom-nav-item <%= currentPath === '/parties' ? 'active' : '' %>">
          <svg class="bottom-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          <span>Parties</span>
        </a>

        <a href="#" data-open-modal="addPartyModal" class="bottom-nav-item bottom-nav-action">
          <svg class="bottom-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
          <span>Add Party</span>
        </a>

        <a href="/profile" class="bottom-nav-item <%= currentPath === '/profile' ? 'active' : '' %>">
          <svg class="bottom-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <span>Profile</span>
        </a>
      </div>
    </nav>
  <% } %>

  <!-- Footer -->
  <footer class="app-footer <%= (typeof currentUser !== 'undefined' && currentUser) ? 'has-bottom-bar' : '' %>">
    <div class="footer-company"><%= company.name %></div>
    <div class="footer-contact">
      <% if (company.address) { %>
        <span class="footer-address"><%= company.address %></span>
      <% } %>
      <% if (company.phone) { %>
        <span class="footer-phone">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -1px; margin-right: 2px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <a href="tel:<%= company.phone %>"><%= company.phone %></a>
        </span>
      <% } %>
    </div>
    <div class="footer-copyright">
      &copy; <%= currentYear %> <%= company.name %>. Powered by <%= app.appShortName %>.
    </div>
  </footer>

  <!-- Zero-CDN Local Scripts with cache busting -->
  <script src="/js/app.js?v=3"></script>
  <script src="/js/pwa-installer.js?v=3"></script>
</body>
</html>
